---
import Label from "./Label.astro";

interface Props {
  label: string;
  title: string;
  intro?: string;
}
const { label, title, intro } = Astro.props;
---

<div class="ph">
  <Label>{label}</Label>
  <h1 class="ph__title">
    <span class="line" style="--i:0" set:html={title} />
  </h1>
  {intro && <p class="ph__intro">{intro}</p>}
  <slot />
</div>

<style>
  .ph {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 1100px;
  }
  .ph__title {
    font-size: clamp(44px, 5.6vw, 84px);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .ph__title .line {
    display: block;
  }
  .ph__intro {
    max-width: 720px;
    font-size: 20px;
    line-height: 1.65;
  }
  @media (max-width: 767px) {
    .ph__intro {
      font-size: var(--t-body);
    }
  }
</style>
