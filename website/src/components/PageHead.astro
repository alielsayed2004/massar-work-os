---
interface Props {
  title: string;
  intro?: string;
  /** Optional link back up the tree, e.g. { href: "/#problems", text: "All problems" }. */
  back?: { href: string; text: string };
}
const { title, intro, back } = Astro.props;
---

<div class="ph">
  {back && (
    <a href={back.href} class="ph__back">
      <span aria-hidden="true">←</span> {back.text}
    </a>
  )}
  <h1 class="ph__title">
    <span class="line" style="--i:0" set:html={title} />
  </h1>
  {intro && <p class="ph__intro">{intro}</p>}
  <slot />
</div>

<style>
  .ph {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 1100px;
  }
  .ph__back {
    align-self: flex-start;
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--green);
  }
  .ph__back span {
    display: inline-block;
    transition: transform 200ms var(--ease-out);
  }
  .ph__back:hover span {
    transform: translateX(-4px);
  }
  .ph__title {
    font-size: var(--fs-statement);
    letter-spacing: -0.025em;
    line-height: 1.04;
  }
  .ph__title .line {
    display: block;
  }
  .ph__intro {
    max-width: 720px;
    font-size: var(--fs-lead);
    line-height: 1.65;
  }
  @media (max-width: 767px) {
    .ph__intro {
      font-size: var(--fs-body);
    }
  }
</style>
