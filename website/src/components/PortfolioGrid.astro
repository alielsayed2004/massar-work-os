---
/**
 * Portfolio index: a packed grid of mixed tile shapes with discipline
 * filters. A tile opens a full-screen view (<dialog>) with the piece's
 * details and, when there is one, a link to its case study. Without JS the
 * tiles are plain links to the full image.
 */
import { getImage } from "astro:assets";
import type { Piece } from "../data/portfolio";
import { disciplines } from "../data/portfolio";

interface Props {
  pieces: Piece[];
}
const { pieces } = Astro.props;
const items = await Promise.all(
  pieces.map(async (p) => {
    const thumb = await getImage({
      src: p.image,
      width: p.size === "wide" ? 960 : 600,
      format: "webp",
      quality: 66,
    });
    const full = await getImage({ src: p.image, width: 1920, format: "webp", quality: 78 });
    return { ...p, thumb: thumb.src, full: full.src };
  }),
);
const used = disciplines.filter((d) => pieces.some((p) => p.discipline === d));
---

<div class="pf" data-pf>
  <div class="pf__filters" role="group" aria-label="Filter the portfolio">
    <button type="button" aria-pressed="true" data-f="">
      All <span>{pieces.length}</span>
    </button>
    {used.map((d) => (
      <button type="button" aria-pressed="false" data-f={d}>
        {d} <span>{pieces.filter((p) => p.discipline === d).length}</span>
      </button>
    ))}
  </div>

  <ul class="pf__grid">
    {items.map((p, i) => (
      <li class:list={["tile", `tile--${p.size}`]} data-d={p.discipline}>
        <a
          href={p.full}
          class="tile__link"
          data-i={i}
          data-title={p.title}
          data-client={p.client}
          data-discipline={p.discipline}
          data-year={p.year}
          data-alt={p.alt}
          data-case={p.caseId ? `/work/${p.caseId}` : ""}
        >
          <img src={p.thumb} alt={p.alt} loading="lazy" decoding="async" />
          <span class="tile__info">
            <span class="tile__title">{p.title}</span>
            <span class="tile__meta">
              {p.client} · {p.discipline}
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <dialog class="lb" aria-label="Portfolio piece" data-lb>
    <div class="lb__frame">
      <img class="lb__img" alt="" data-lb-img />
      <div class="lb__bar">
        <div class="lb__text">
          <p class="lb__title" data-lb-title></p>
          <p class="lb__meta" data-lb-meta></p>
        </div>
        <div class="lb__actions">
          <a class="lb__case" href="/work" data-lb-case hidden>
            Read the case <span aria-hidden="true">→</span>
          </a>
          <button type="button" class="lb__nav" data-lb-prev aria-label="Previous piece">
            ←
          </button>
          <button type="button" class="lb__nav" data-lb-next aria-label="Next piece">
            →
          </button>
          <button type="button" class="lb__close" data-lb-close>
            Close
          </button>
        </div>
      </div>
      <p class="lb__tag">Generated image · demo</p>
    </div>
  </dialog>
</div>

<script>
  function initPortfolio() {
    const root = document.querySelector<HTMLElement>("[data-pf]");
    if (!root) return;
    const tiles = [...root.querySelectorAll<HTMLLIElement>(".tile")];
    const links = [...root.querySelectorAll<HTMLAnchorElement>(".tile__link")];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-f]")];
    const dlg = root.querySelector<HTMLDialogElement>("[data-lb]")!;
    const img = dlg.querySelector<HTMLImageElement>("[data-lb-img]")!;
    const title = dlg.querySelector<HTMLElement>("[data-lb-title]")!;
    const meta = dlg.querySelector<HTMLElement>("[data-lb-meta]")!;
    const caseLink = dlg.querySelector<HTMLAnchorElement>("[data-lb-case]")!;
    let current = 0;

    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        const f = b.dataset.f;
        tiles.forEach((t) => (t.hidden = !!f && t.dataset.d !== f));
      }),
    );

    const visible = () => links.filter((l) => !(l.closest(".tile") as HTMLElement).hidden);
    const show = (link: HTMLAnchorElement) => {
      current = visible().indexOf(link);
      img.src = link.href;
      img.alt = link.dataset.alt ?? "";
      title.textContent = link.dataset.title ?? "";
      meta.textContent = [link.dataset.client, link.dataset.discipline, link.dataset.year].join(
        " · ",
      );
      caseLink.hidden = !link.dataset.case;
      if (link.dataset.case) caseLink.href = link.dataset.case;
    };
    const step = (d: number) => {
      const v = visible();
      show(v[(current + d + v.length) % v.length]);
    };

    links.forEach((l) =>
      l.addEventListener("click", (e) => {
        e.preventDefault();
        show(l);
        dlg.showModal();
      }),
    );
    dlg.querySelector("[data-lb-close]")!.addEventListener("click", () => dlg.close());
    dlg.querySelector("[data-lb-prev]")!.addEventListener("click", () => step(-1));
    dlg.querySelector("[data-lb-next]")!.addEventListener("click", () => step(1));
    dlg.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
  }
  document.addEventListener("astro:page-load", initPortfolio);
</script>

<style>
  .pf {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .pf__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pf__filters button {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--ink);
    background: none;
    color: var(--ink);
    font-size: var(--fs-xs);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      transform 140ms var(--ease-out);
  }
  .pf__filters button span {
    opacity: 0.6;
  }
  .pf__filters button:active {
    transform: scale(0.97);
  }
  .pf__filters button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--white);
  }

  .pf__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(160px, 19vw, 260px);
    grid-auto-flow: dense;
    gap: var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tile {
    grid-column: span 4;
  }
  .tile--wide {
    grid-column: span 8;
  }
  .tile--tall {
    grid-row: span 2;
  }
  .tile[hidden] {
    display: none;
  }
  .tile__link {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--ink);
  }
  .tile__link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 900ms var(--ease-out),
      opacity 300ms ease;
  }
  .tile__link:hover img {
    transform: scale(1.04);
    opacity: 0.75;
  }
  .tile__info {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 40px 18px 16px;
    background: linear-gradient(to top, rgb(16 24 21 / 0.85), transparent);
    color: var(--white);
    transform: translateY(8px);
    opacity: 0;
    transition:
      opacity 300ms ease,
      transform 300ms var(--ease-out);
  }
  .tile__link:hover .tile__info,
  .tile__link:focus-visible .tile__info {
    opacity: 1;
    transform: none;
  }
  .tile__title {
    font-size: var(--fs-body);
    font-weight: 500;
  }
  .tile__meta {
    font-size: var(--fs-xs);
    opacity: 0.85;
  }
  @media (hover: none) {
    .tile__info {
      opacity: 1;
      transform: none;
    }
  }

  .lb {
    width: min(1280px, 94vw);
    max-width: none;
    max-height: 94vh;
    margin: auto;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--white);
  }
  .lb::backdrop {
    background: rgb(16 24 21 / 0.92);
  }
  .lb[open] {
    animation: lb-in 320ms var(--ease-out);
  }
  .lb__frame {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .lb__img {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    background: var(--ink);
  }
  .lb__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding: 18px 24px;
  }
  .lb__title {
    font-size: var(--fs-h3);
    font-weight: 500;
  }
  .lb__meta {
    font-size: var(--fs-xs);
    opacity: 0.8;
  }
  .lb__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lb__case {
    margin-right: 12px;
    padding-bottom: 3px;
    border-bottom: 2px solid var(--clay);
    font-size: var(--fs-body);
    font-weight: 500;
  }
  .lb__nav,
  .lb__close {
    min-width: 44px;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--white);
    background: none;
    color: var(--white);
    font-size: var(--fs-body);
    cursor: pointer;
  }
  .lb__nav:hover,
  .lb__close:hover {
    background: var(--white);
    color: var(--ink);
  }
  .lb__tag {
    position: absolute;
    left: 12px;
    top: 12px;
    padding: 3px 7px;
    background: var(--ink);
    font-size: 12px;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }
  @media (max-width: 767px) {
    .pf__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 150px;
      gap: 10px;
    }
    .tile {
      grid-column: span 1;
    }
    .tile--wide {
      grid-column: span 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lb[open] {
      animation: none;
    }
  }
</style>
