---
/**
 * Opening logo motion, once per visit. The monogram's four arms (the real
 * artwork, each clipped to its quarter) travel in from the edges and lock
 * into the mark, the wordmark rises under it, then the curtain lifts.
 * Shown only when <html> has the `intro` class, which an inline script in
 * <head> sets on the first page view of a session, never under reduced
 * motion. Click or any key skips it.
 */
const arms = ["top", "right", "bottom", "left"];
---

<div class="intro" aria-hidden="true" data-intro>
  <div class="intro__mark">
    {arms.map((a) => (
      <img
        src="/brand/massar_mono_bone.png"
        width="639"
        height="635"
        alt=""
        class:list={["intro__arm", `intro__arm--${a}`]}
      />
    ))}
  </div>
  <img src="/brand/massar_wordmark_bone.png" width="538" height="87" alt="" class="intro__word" />
  <span class="intro__line"></span>
</div>

<script>
  function initIntro() {
    const root = document.documentElement;
    if (!root.classList.contains("intro")) return;
    const el = document.querySelector<HTMLElement>("[data-intro]");
    const done = () => root.classList.remove("intro");
    const t = window.setTimeout(done, 2600);
    const skip = () => {
      window.clearTimeout(t);
      done();
    };
    el?.addEventListener("click", skip, { once: true });
    window.addEventListener("keydown", skip, { once: true });
  }
  initIntro();
</script>

<style>
  .intro {
    display: none;
  }
  :global(html.intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 28px;
    background: var(--ink);
    cursor: pointer;
    animation: intro-lift 700ms var(--ease-in-out) 1750ms forwards;
  }
  :global(html.intro) {
    overflow: hidden;
  }
  .intro__mark {
    position: relative;
    width: clamp(96px, 12vw, 148px);
    aspect-ratio: 639 / 635;
  }
  .intro__arm {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    animation: intro-arm 900ms var(--ease-out) forwards;
  }
  .intro__arm--top {
    clip-path: polygon(0 0, 100% 0, 50% 50%);
    --from: 0 -140%;
    animation-delay: 150ms;
  }
  .intro__arm--right {
    clip-path: polygon(100% 0, 100% 100%, 50% 50%);
    --from: 140% 0;
    animation-delay: 230ms;
  }
  .intro__arm--bottom {
    clip-path: polygon(0 100%, 100% 100%, 50% 50%);
    --from: 0 140%;
    animation-delay: 310ms;
  }
  .intro__arm--left {
    clip-path: polygon(0 0, 0 100%, 50% 50%);
    --from: -140% 0;
    animation-delay: 390ms;
  }
  .intro__word {
    width: clamp(120px, 14vw, 180px);
    height: auto;
    opacity: 0;
    animation: intro-word 600ms var(--ease-out) 1050ms forwards;
  }
  .intro__line {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 4px;
    background: var(--clay);
    transform: scaleX(0);
    transform-origin: left;
    animation: intro-line 1500ms var(--ease-in-out) 200ms forwards;
  }
  @keyframes intro-arm {
    from {
      opacity: 0;
      translate: var(--from);
    }
    30% {
      opacity: 1;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @keyframes intro-word {
    from {
      opacity: 0;
      translate: 0 12px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @keyframes intro-line {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes intro-lift {
    to {
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
    }
  }
</style>
