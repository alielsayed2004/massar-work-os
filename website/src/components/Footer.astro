---
import { org } from "../data/site";

const year = new Date().getFullYear();
const links = [
  { href: "/work", label: "Work" },
  { href: "/problems", label: "Problems" },
  { href: "/services", label: "Services" },
  { href: "/process", label: "Process" },
  { href: "/about", label: "About" },
  { href: "/notes", label: "Notes" },
  { href: "/privacy", label: "Privacy" },
  { href: `mailto:${org.email}`, label: org.email },
];
---

<footer class="footer">
  {Astro.slots.has("default") && (
    <div class="container footer__above">
      <slot />
    </div>
  )}
  <div class="container footer__inner">
    <a href="/" aria-label="Massar — home">
      <img src="/brand/massar_wordmark_white.png" width="222" height="36" alt="Massar" />
    </a>
    <nav aria-label="Footer">
      <ul class="footer__links">
        {links.map((l) => (
          <li>
            <a class="u-grow" href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <span>© {year} Massar</span>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--white);
  }
  .footer__above {
    padding-block: var(--s-6) var(--s-5);
    border-bottom: 1px solid var(--white);
  }
  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    padding-block: 48px;
  }
  .footer img {
    height: 28px;
    width: auto;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.5;
  }
</style>
