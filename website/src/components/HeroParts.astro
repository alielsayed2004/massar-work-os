---
/**
 * Home hero. The "moving parts" are the marketing pieces every growing
 * business juggles, scattered across the screen. As you scroll they fold
 * onto one line: one clear direction. Without JS, or under reduced motion,
 * the hero shows the finished state.
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import billboard from "../assets/demo/billboard-desert.jpg";
import cafe from "../assets/demo/cafe-counter.jpg";
import shop from "../assets/demo/retail.jpg";

const thumb = async (src: ImageMetadata) =>
  (await getImage({ src, width: 400, format: "webp", quality: 65 })).src;

// Start (scattered) and end (on the line) positions, in % of the hero.
const parts = [
  {
    kind: "photo",
    img: await thumb(billboard),
    label: "Billboard",
    note: "Agency A",
    sx: 4,
    sy: 14,
    sr: -8,
  },
  {
    kind: "post",
    img: await thumb(cafe),
    label: "Social post",
    note: "37 of 60 this month",
    sx: 70,
    sy: 8,
    sr: 6,
  },
  { kind: "file", label: "logo_v7_FINAL_final.ai", note: "Freelancer", sx: 56, sy: 30, sr: -4 },
  { kind: "tag", label: "Ad set 12", note: "Paused", sx: 82, sy: 40, sr: 9 },
  { kind: "doc", label: "Brief, draft 4", note: "Nobody signed it", sx: 2, sy: 52, sr: 5 },
  {
    kind: "photo",
    img: await thumb(shop),
    label: "Shop window",
    note: "Printer B",
    sx: 64,
    sy: 62,
    sr: -7,
  },
  { kind: "doc", label: "Invoice", note: "Supplier 5 of 5", sx: 32, sy: 4, sr: 3 },
  { kind: "tag", label: "Website v3", note: "Launch pending", sx: 40, sy: 68, sr: -5 },
];
const n = parts.length;
---

<section class="hp" aria-labelledby="hero-title" data-hero-parts>
  <div class="hp__stage">
    <div class="hp__parts" aria-hidden="true">
      {parts.map((p, i) => (
        <div
          class:list={["part", `part--${p.kind}`]}
          style={`--sx:${p.sx};--sy:${p.sy};--sr:${p.sr}deg;--ex:${(i / (n - 1)) * 82 + 2};--mx:${4 + (i % 2) * 48};--my:${37 + Math.floor(i / 2) * 6};--i:${i}`}
        >
          {p.img && <img src={p.img} alt="" width="400" height="300" loading="eager" />}
          <span class="part__label">{p.label}</span>
          <span class="part__note">{p.note}</span>
        </div>
      ))}
      <span class="hp__line"></span>
    </div>

    <div class="container hp__copy">
      <h1 id="hero-title" class="hp__title">
        <span class="line" style="--i:0">
          Too many
        </span>
        <span class="line" style="--i:1">
          moving parts?
        </span>
      </h1>
      <p class="hp__answer">
        <span>One clear direction.</span>
      </p>
    </div>

    <div class="container hp__foot">
      <p class="hp__sub">
        Massar is a marketing and business partner in Cairo. We find the real problem behind the
        brand, the ads or the launch, set one direction, and own the result.
      </p>
      <div class="hp__ctas">
        <a href="/start" class="hp__btn hp__btn--primary">
          Bring us the problem
        </a>
        <a href="/problems" class="hp__btn">
          See what we solve
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  function initHeroParts() {
    const root = document.querySelector<HTMLElement>("[data-hero-parts]");
    if (!root) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      root.style.setProperty("--p", "1");
      return;
    }
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = root.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -r.top / (span * 0.8))) : 1;
      root.style.setProperty("--p", p.toFixed(3));
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
      },
      { once: true },
    );
  }
  document.addEventListener("astro:page-load", initHeroParts);
</script>

<style>
  .hp {
    --p: 1;
    position: relative;
    background: var(--ink);
    color: var(--white);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hp {
      --p: 0;
      height: 220svh;
    }
    :global(.js) .hp__stage {
      position: sticky;
      top: 0;
      height: 100svh;
    }
  }
  .hp__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: max(100svh, 700px);
    overflow: hidden;
  }

  /* Eased progress: the parts settle rather than slide linearly. */
  .hp__parts {
    --e: calc(1 - (1 - var(--p)) * (1 - var(--p)) * (1 - var(--p)));
    position: absolute;
    inset: 96px 0 0;
  }
  .part {
    position: absolute;
    left: calc((var(--sx) + (var(--ex) - var(--sx)) * var(--e)) * 1%);
    top: calc((var(--sy) + (56 - var(--sy)) * var(--e)) * 1%);
    width: clamp(120px, 13vw, 200px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 10px 12px;
    background: var(--white);
    color: var(--ink);
    rotate: calc(var(--sr) * (1 - var(--e)));
    scale: calc(1 - 0.15 * var(--e));
    will-change: left, top, rotate;
  }
  .part img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: 6px;
  }
  .part--post img {
    aspect-ratio: 1;
  }
  .part--file {
    background: var(--bone);
  }
  .part--tag {
    background: var(--green);
    color: var(--white);
  }
  .part--doc {
    background: var(--bone);
    padding-top: 28px;
  }
  .part__label {
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .part__note {
    font-size: 12px;
    line-height: 1.3;
    opacity: 0.75;
  }
  .hp__line {
    position: absolute;
    left: 2%;
    right: 2%;
    top: calc(56% - 14px);
    height: 6px;
    background: var(--green);
    transform: scaleX(var(--e));
    transform-origin: left;
  }

  .hp__copy {
    position: relative;
    z-index: 1;
    padding-top: clamp(120px, 18svh, 200px);
    pointer-events: none;
  }
  .hp__title {
    font-size: var(--fs-display);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-shadow: 0 2px 24px rgb(16 24 21 / 0.6);
  }
  .hp__title .line {
    display: block;
  }
  .hp__answer {
    margin-top: 24px;
    font-size: var(--fs-statement);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--bone);
    opacity: calc(var(--p) * 1.6 - 0.3);
    translate: 0 calc((1 - var(--p)) * 24px);
  }
  .hp__answer span {
    background-image: linear-gradient(var(--clay), var(--clay));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 6px;
    padding-bottom: 6px;
  }

  .hp__foot {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 24px var(--gutter);
    align-items: end;
    padding-bottom: 40px;
  }
  .hp__sub {
    max-width: 46ch;
    font-size: var(--fs-lead);
    line-height: 1.55;
  }
  .hp__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px;
  }
  .hp__btn {
    display: inline-block;
    padding: 16px 28px;
    border: 1px solid var(--white);
    font-size: var(--fs-body);
    font-weight: 500;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      transform 140ms var(--ease-out);
  }
  .hp__btn:hover {
    background: var(--white);
    color: var(--ink);
  }
  .hp__btn:active {
    transform: scale(0.97);
  }
  .hp__btn--primary {
    background: var(--white);
    color: var(--ink);
  }
  .hp__btn--primary:hover {
    background: var(--bone);
  }

  @media (max-width: 1023px) {
    .hp__foot {
      grid-template-columns: 1fr;
    }
    .hp__ctas {
      justify-content: flex-start;
    }
  }
  /* Phones: the parts fold into two tidy columns of labels above the copy. */
  @media (max-width: 767px) {
    .hp__parts {
      inset: 64px 0 0;
    }
    .part {
      left: calc((var(--sx) * 0.7 + (var(--mx) - var(--sx) * 0.7) * var(--e)) * 1%);
      top: calc((var(--sy) * 0.5 + (var(--my) - var(--sy) * 0.5) * var(--e)) * 1%);
      width: 44vw;
      padding: 8px 10px;
    }
    .part img,
    .part__note {
      display: none;
    }
    .part--doc {
      padding-top: 8px;
    }
    .hp__line {
      display: none;
    }
    .hp__sub {
      font-size: var(--fs-body);
    }
  }
</style>
