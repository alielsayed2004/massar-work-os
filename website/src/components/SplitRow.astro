---
/**
 * Editorial row: a large cinematic picture beside its text, 7/5 columns,
 * alternating sides. The picture scales in gently as it enters.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Picture on the right instead of the left. */
  flip?: boolean;
  id?: string;
  demo?: boolean;
  tone?: "white" | "ink" | "bone";
}
const { image, alt, flip = false, id, demo = true, tone = "white" } = Astro.props;
---

<article id={id} class:list={["split", { "split--flip": flip }, `split--${tone}`]}>
  <figure class="split__media">
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1440]}
      sizes="(min-width: 1200px) 760px, 100vw"
      format="webp"
      quality={72}
      class="split__img scale-in"
    />
    {demo && <figcaption class="split__tag">Generated image · demo</figcaption>}
  </figure>
  <div class="split__body">
    <slot />
  </div>
</article>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px 64px;
    align-items: center;
    scroll-margin-top: 24px;
  }
  .split--flip {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }
  .split--flip .split__media {
    order: 2;
  }
  .split__media {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .split__media :global(.split__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  .split__media:hover :global(.split__img) {
    transform: scale(1.03);
  }
  .split__tag {
    position: absolute;
    left: 14px;
    bottom: 12px;
    padding: 4px 8px;
    background: var(--ink);
    color: var(--white);
    font-size: 12px;
  }
  .split__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (max-width: 1023px) {
    .split,
    .split--flip {
      grid-template-columns: 1fr;
    }
    .split--flip .split__media {
      order: 0;
    }
  }
</style>
