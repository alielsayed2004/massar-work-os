---
/**
 * Hero monogram on a Bone panel. The static PNG is the LCP element and the
 * fallback (mobile < 768px, reduced motion, no WebGL). On larger screens the
 * three.js scene loads when the panel is visible and fades in over it.
 */
---

<div class="mono" data-monogram>
  <div class="mono__static" aria-hidden="true">
    <img src="/brand/massar_mono_ink.png" width="263" height="262" alt="" class="s s4" />
    <img src="/brand/massar_mono_ink.png" width="263" height="262" alt="" class="s s3" />
    <img src="/brand/massar_mono_ink.png" width="263" height="262" alt="" class="s s2" />
    <img src="/brand/massar_mono_ink.png" width="263" height="262" alt="" class="s s1" />
  </div>
  <img
    src="/brand/massar_mono_green.png"
    width="599"
    height="596"
    alt="The Massar monogram: four arms that point to one centre"
    class="mono__front"
    fetchpriority="high"
  />
</div>

<script>
  let teardown: (() => void) | undefined;

  function webgl() {
    try {
      return !!document.createElement("canvas").getContext("webgl2");
    } catch {
      return false;
    }
  }

  function initMonogram() {
    teardown?.();
    teardown = undefined;
    const host = document.querySelector<HTMLElement>("[data-monogram]");
    if (!host) return;
    if (
      window.innerWidth < 768 ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      !webgl()
    )
      return;
    const io = new IntersectionObserver(async ([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      try {
        const { mountMonogram } = await import("./monogram-scene");
        teardown = await mountMonogram(host, "/brand/massar_mono_green.png");
      } catch {
        // Keep the static image.
      }
    });
    io.observe(host);
  }

  document.addEventListener("astro:page-load", initMonogram);
  document.addEventListener("astro:before-swap", () => {
    teardown?.();
    teardown = undefined;
  });
</script>

<style>
  .mono {
    position: relative;
    width: 100%;
    height: clamp(280px, 30vw, 420px);
    background: var(--bone);
    overflow: hidden;
  }
  .mono__static,
  .mono__front {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(300px, 62%);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }
  .mono__front {
    height: auto;
  }
  .mono :global(.mono__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 400ms var(--ease);
  }
  .mono:global(.is-3d) :global(.mono__canvas) {
    opacity: 1;
  }
  .mono__static,
  .mono__front {
    transition: opacity 400ms var(--ease);
  }
  .mono:global(.is-3d) .mono__static,
  .mono:global(.is-3d) .mono__front {
    opacity: 0;
  }
  .s {
    position: absolute;
    inset: 0;
    width: 100%;
    height: auto;
  }
  .s1 {
    translate: 1% 1%;
  }
  .s2 {
    translate: 2% 2%;
    opacity: 0.6;
  }
  .s3 {
    translate: 3.3% 3.3%;
    opacity: 0.4;
  }
  .s4 {
    translate: 4.6% 4.6%;
    opacity: 0.25;
  }
</style>
