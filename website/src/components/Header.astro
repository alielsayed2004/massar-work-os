---
import { nav } from "../data/site";

interface Props {
  /** "light" = white header (home); "ink" = dark header (case pages). */
  variant?: "light" | "ink" | "overlay";
}

const { variant = "light" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => !href.includes("#") && path.startsWith(href);
const logo =
  variant !== "light"
    ? { src: "/brand/massar_wordmark_white.png", width: 222, height: 36 }
    : { src: "/brand/massar_wordmark_green.png", width: 505, height: 82 };
---

<header class:list={["header", `header--${variant}`]} data-header>
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Massar — home">
      <img src={logo.src} width={logo.width} height={logo.height} alt="Massar" />
    </a>
    <nav aria-label="Main" class="header__desktop">
      <ul class="header__nav">
        {nav.map((l) => (
          <li>
            <a href={l.href} class="u-grow" aria-current={isCurrent(l.href) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/start" class="header__cta">
            Start a project
          </a>
        </li>
      </ul>
    </nav>
    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <span class="visually-hidden">Open menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>
  </div>

  <div id="mobile-menu" class="menu tone-ink" hidden data-menu>
    <div class="container menu__top">
      <a href="/" aria-label="Massar — home">
        <img src="/brand/massar_wordmark_white.png" width="222" height="36" alt="Massar" />
      </a>
      <button type="button" class="header__toggle menu__close" data-menu-close>
        <span class="visually-hidden">Close menu</span>
        <span class="burger burger--x" aria-hidden="true"></span>
      </button>
    </div>
    <nav aria-label="Mobile" class="container menu__body">
      <ul>
        {nav.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/start" class="menu__cta">
        Start a project
      </a>
    </nav>
  </div>
</header>

<script>
  function initMenu() {
    const header = document.querySelector<HTMLElement>("[data-header]");
    const menu = header?.querySelector<HTMLElement>("[data-menu]");
    const openBtn = header?.querySelector<HTMLButtonElement>("[data-menu-open]");
    const closeBtn = header?.querySelector<HTMLButtonElement>("[data-menu-close]");
    if (!header || !menu || !openBtn || !closeBtn) return;

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      openBtn.setAttribute("aria-expanded", String(open));
      document.documentElement.style.overflow = open ? "hidden" : "";
      (open ? closeBtn : openBtn).focus();
    };
    openBtn.addEventListener("click", () => setOpen(true));
    closeBtn.addEventListener("click", () => setOpen(false));
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  }
  document.addEventListener("astro:page-load", initMenu);
</script>

<style>
  .header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--ink);
    background: var(--white);
    color: var(--green);
  }
  .header--ink {
    border-bottom-color: var(--white);
    background: var(--ink);
    color: var(--white);
  }
  .header--overlay {
    position: absolute;
    inset: 0 0 auto;
    border-bottom-color: transparent;
    background: transparent;
    color: var(--white);
  }
  .header--overlay .header__cta {
    background: var(--white);
    color: var(--ink);
  }
  .header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-block: 22px;
  }
  .header__logo img,
  .menu__top img {
    height: 32px;
    width: auto;
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-body);
    font-weight: 500;
    line-height: 1.4;
  }
  .header__cta {
    display: inline-block;
    padding: 13px 22px;
    background: var(--ink);
    color: var(--white);
    font-weight: 500;
  }
  .header--ink .header__cta {
    background: var(--white);
    color: var(--ink);
  }

  .header__toggle {
    display: none;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: inherit;
  }
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 24px;
    height: 2px;
    margin-inline: auto;
    background: currentColor;
  }
  .burger {
    position: relative;
  }
  .burger::before,
  .burger::after {
    content: "";
    position: absolute;
    left: 0;
  }
  .burger::before {
    top: -7px;
  }
  .burger::after {
    top: 7px;
  }
  .burger--x {
    background: transparent;
  }
  .burger--x::before {
    top: 0;
    transform: rotate(45deg);
  }
  .burger--x::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }
  .menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 22px;
    border-bottom: 1px solid var(--white);
  }
  .menu__close {
    display: block;
  }
  .menu__body {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 40px;
  }
  .menu__body ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu__body li a {
    display: block;
    padding: 12px 0;
    font-size: var(--fs-title);
    letter-spacing: -0.015em;
    font-weight: 500;
    line-height: 1.15;
  }
  .menu__body li a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--clay);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .menu__cta {
    align-self: flex-start;
    padding: 18px 34px;
    background: var(--white);
    color: var(--ink);
    font-size: var(--fs-body);
    font-weight: 500;
  }

  @media (max-width: 1023px) {
    .header__desktop {
      display: none;
    }
    .header__toggle {
      display: block;
    }
  }
</style>
