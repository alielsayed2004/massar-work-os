---
import Button from "./Button.astro";
import { org } from "../data/site";
import { getProblems } from "../lib/content";

interface Props {
  title?: string;
  /** Show the "Which one is yours?" problem links. */
  picks?: boolean;
}
const { title = "Bring us the problem.<br />We'll bring one direction.", picks = true } =
  Astro.props;
const problems = picks ? await getProblems() : [];
---

<section class="cta tone-green" aria-labelledby="cta-title">
  <div class="container cta__inner" class:list={{ "cta__inner--solo": !problems.length }}>
    <div class="cta__main">
      <div class="cta__rule" aria-hidden="true"></div>
      <h2 id="cta-title" class="cta__title" set:html={title} />
      <p class="cta__tagline">{org.tagline}</p>
    </div>
    <div class="cta__pick">
      {problems.length > 0 && (
        <>
          <p class="cta__ask">Which one is yours?</p>
          <ul>
            {problems.map((p) => (
              <li>
                <a href={`/start?problem=${encodeURIComponent(p.data.title)}`}>
                  "{p.data.title}" <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
      <Button href="/start" on="dark" size="lg">
        Start a project
      </Button>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: 56px;
    padding-block: var(--section-y);
  }
  .cta__main {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .cta__rule {
    width: 96px;
    height: 6px;
    background: var(--clay);
  }
  .cta__title {
    font-size: var(--fs-statement);
    letter-spacing: -0.025em;
    line-height: 1.02;
  }
  .cta__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: var(--fs-title);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .cta__pick {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cta__inner--solo .cta__pick {
    justify-self: end;
  }
  .cta__ask {
    font-size: var(--fs-lead);
    font-weight: 500;
  }
  .cta__pick ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }
  .cta__pick li a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    background: var(--white);
    color: var(--green);
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.35;
    transition: transform 200ms var(--ease-out);
  }
  .cta__pick li a:hover {
    transform: translateX(6px);
  }
  .cta__pick li a span {
    color: var(--clay);
  }
  .cta__pick :global(.btn) {
    align-self: flex-start;
  }
  @media (max-width: 1023px) {
    .cta__inner {
      grid-template-columns: 1fr;
    }
    .cta__inner--solo .cta__pick {
      justify-self: start;
    }
  }
</style>
