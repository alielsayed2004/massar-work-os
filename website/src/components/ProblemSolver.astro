---
/**
 * Interactive "pick your problem" panel: buyer problem → what's usually behind
 * it → what we do → proof (a case). Tabs follow the ARIA tabs pattern; without
 * JS every panel is shown in order.
 */
import Media from "./Media.astro";
import type { Problem, Work } from "../lib/content";
import { casesFor } from "../lib/content";

interface Props {
  problems: Problem[];
  work: Work[];
}
const { problems, work } = Astro.props;
const items = problems.map((p) => ({ p, proof: casesFor(p.id, work)[0] }));
---

<div class="solver" data-solver>
  <div class="solver__tabs" role="tablist" aria-label="Pick the problem that sounds like you">
    {items.map(({ p }, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${p.id}`}
        aria-controls={`panel-${p.id}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        class="solver__tab"
      >
        <span class="solver__q">"{p.data.title}"</span>
        <span class="solver__arrow" aria-hidden="true">
          →
        </span>
      </button>
    ))}
    <a href="/start" class="solver__other">
      Something else? <span class="link">Tell us the problem</span>
    </a>
  </div>

  <div class="solver__panels">
    {items.map(({ p, proof }, i) => (
      <div
        role="tabpanel"
        id={`panel-${p.id}`}
        aria-labelledby={`tab-${p.id}`}
        class="solver__panel"
        data-active={i === 0 ? "" : undefined}
        tabindex="0"
      >
        <div class="solver__steps">
          <div class="solver__step">
            <span class="solver__label">Usually behind it</span>
            <p class="solver__big">{p.data.cause}</p>
          </div>
          <div class="solver__step">
            <span class="solver__label">What we do</span>
            <p class="solver__big solver__big--green">{p.data.short}</p>
          </div>
        </div>
        {proof && (
          <a href={`/work/${proof.id}`} class="solver__proof">
            <Media
              image={proof.data.hero}
              alt={proof.data.heroAlt}
              shot={proof.data.heroShot}
              tone={proof.data.heroTone}
              tag={proof.data.demoImages ? "Stock photo · demo" : undefined}
              height="220px"
              sizes="(min-width: 1200px) 360px, 100vw"
            />
            <span class="solver__proofbody">
              <span class="solver__label">Proof</span>
              <span class="solver__prooftitle">
                {proof.data.client}: {proof.data.summary}
              </span>
              {proof.data.results[0] && (
                <span class="solver__result">
                  <b>{proof.data.results[0].value}</b> {proof.data.results[0].metric}
                </span>
              )}
              <span class="link">Read the case</span>
            </span>
          </a>
        )}
        <a href={`/problems/${p.id}`} class="solver__more link">
          How we solve "{p.data.title}"
        </a>
      </div>
    ))}
  </div>
</div>

<script>
  function initSolver() {
    document.querySelectorAll<HTMLElement>("[data-solver]").forEach((root) => {
      root.classList.add("is-js");
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (tab: HTMLButtonElement, focus = false) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(t.getAttribute("aria-controls")!);
          panel?.toggleAttribute("data-active", on);
        });
        if (focus) tab.focus();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (e) => {
          const d =
            e.key === "ArrowDown" || e.key === "ArrowRight"
              ? 1
              : e.key === "ArrowUp" || e.key === "ArrowLeft"
                ? -1
                : 0;
          if (!d) return;
          e.preventDefault();
          select(tabs[(i + d + tabs.length) % tabs.length], true);
        });
      });
    });
  }
  document.addEventListener("astro:page-load", initSolver);
</script>

<style>
  .solver {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--gutter) 64px;
    align-items: start;
  }
  .solver__tabs {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .solver__tab {
    display: grid;
    grid-template-columns: 1fr 24px;
    align-items: baseline;
    gap: 12px;
    width: 100%;
    padding: 20px 24px;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    color: var(--ink);
    transition:
      padding 240ms var(--ease),
      background-color 240ms var(--ease),
      color 240ms var(--ease);
  }
  .solver__q {
    font-size: clamp(22px, 2.1vw, 30px);
    font-weight: 600;
    line-height: 1.25;
  }
  .solver__arrow {
    font-size: 24px;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 240ms var(--ease),
      transform 240ms var(--ease);
  }
  .is-js .solver__tab[aria-selected="true"] {
    background: var(--ink);
    color: var(--white);
  }
  .is-js .solver__tab[aria-selected="true"] .solver__arrow {
    opacity: 1;
    transform: none;
    color: var(--clay);
  }
  .solver__other {
    padding: 20px 24px 0;
    font-size: 16px;
  }
  .solver__other .link {
    margin-left: 6px;
    color: var(--green);
  }

  .is-js .solver__panel:not([data-active]) {
    display: none;
  }
  .solver__panel {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 40px;
    background: var(--bone);
  }
  .is-js .solver__panel[data-active] {
    animation: panel-in 420ms var(--ease);
  }
  .solver__panel + .solver__panel {
    margin-top: var(--gutter);
  }
  .is-js .solver__panel + .solver__panel {
    margin-top: 0;
  }
  .solver__steps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .solver__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .solver__label {
    font-size: 15px;
    font-weight: 600;
    color: var(--green);
  }
  .solver__big {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.45;
  }
  .solver__big--green {
    color: var(--green);
    font-weight: 600;
  }
  .solver__proof {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--white);
  }
  .solver__proofbody {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
  }
  .solver__prooftitle {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
  }
  .solver__result {
    font-size: 16px;
  }
  .solver__proof .link {
    margin-top: auto;
    color: var(--green);
    font-size: 15px;
  }
  .solver__more {
    align-self: flex-start;
    color: var(--green);
    font-size: 15px;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (max-width: 1023px) {
    .solver {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .solver__panel {
      padding: 24px 20px;
    }
    .solver__steps,
    .solver__proof {
      grid-template-columns: 1fr;
    }
    .solver__big {
      font-size: 19px;
    }
  }
</style>
