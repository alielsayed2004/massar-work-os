---
import type { ImageMetadata } from "astro";
import Media from "./Media.astro";

interface Props {
  href: string;
  slug: string;
  client: string;
  summary: string;
  tags: string[];
  sector: string;
  result?: { value: string; metric: string };
  shot: string;
  image?: ImageMetadata;
  alt?: string;
  demo?: boolean;
  /** CSS height of the image. */
  height?: string;
  tone?: "stone" | "ink" | "bone" | "white";
  /** Tag list used by the /work filter. */
  filterTags?: string[];
}
const {
  href,
  slug,
  client,
  summary,
  tags,
  sector,
  result,
  shot,
  tone,
  filterTags,
  image,
  alt,
  demo,
  height = "clamp(260px, 30vw, 440px)",
} = Astro.props;
const kicker = [...tags, sector].join(" · ");
---

<article class="ccard" data-tilt data-tags={(filterTags ?? tags).join(",")}>
  <a href={href} class="ccard__link">
    <div class="ccard__media">
      <Media
        image={image}
        alt={alt}
        tag={demo ? "Stock photo · demo" : undefined}
        sizes="(min-width: 1200px) 640px, 100vw"
        shot={shot}
        tone={tone}
        height={height}
        class="ccard__img"
        transitionName={`case-${slug}`}
      />
    </div>
    <span class="ccard__kicker">{kicker}</span>
    <h3 class="ccard__title">
      {client}: {summary}
    </h3>
    {result && (
      <p class="ccard__result">
        Result: <b>{result.value}</b> {result.metric}
      </p>
    )}
  </a>
</article>

<style>
  .ccard {
    perspective: 1000px;
  }
  .ccard__link {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ccard__media {
    overflow: hidden;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 400ms var(--ease);
  }
  .ccard__media :global(.ccard__img) {
    transition: transform 400ms var(--ease);
  }
  .ccard:hover .ccard__media :global(.ccard__img) {
    transform: scale(1.02);
  }
  .ccard__kicker {
    font-size: 15px;
    line-height: 1.4;
    opacity: 0.8;
  }
  .ccard__title {
    font-size: var(--t-h3);
    font-weight: 600;
    line-height: 1.25;
  }
  .ccard__link:hover .ccard__title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    text-decoration-color: var(--clay);
  }
  .ccard__result {
    font-size: 17px;
    line-height: 1.6;
  }
  @media (prefers-reduced-motion: reduce) {
    .ccard__media,
    .ccard:hover .ccard__media :global(.ccard__img) {
      transform: none;
    }
  }
</style>
