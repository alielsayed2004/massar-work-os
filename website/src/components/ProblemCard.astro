---
interface Props {
  index: number;
  title: string;
  answer: string;
  href: string;
}
const { index, title, answer, href } = Astro.props;
---

<a href={href} class="pcard" data-reveal>
  <span class="pcard__num">P/{String(index).padStart(2, "0")}</span>
  <span class="pcard__title">"{title}"</span>
  <span class="pcard__answer">{answer}</span>
  <span class="link pcard__more">See the case</span>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px 28px 32px 0;
    border-top: 1px solid var(--ink);
    color: var(--ink);
  }
  .pcard__num {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--green);
  }
  .pcard__title {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.3;
  }
  .pcard__answer {
    font-size: 16px;
    line-height: 1.6;
  }
  .pcard__more {
    margin-top: auto;
    font-size: 14px;
    color: var(--green);
  }
  .pcard:hover .pcard__more {
    animation: link-regrow 240ms var(--ease);
  }
</style>
