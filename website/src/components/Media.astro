---
/**
 * Shows a real image when one is set, otherwise the labeled REAL PHOTO
 * placeholder. Images go through astro:assets (WebP, responsive widths).
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
  image?: ImageMetadata;
  alt?: string;
  shot?: string;
  label?: string;
  tone?: "stone" | "ink" | "bone" | "white";
  height?: string;
  kind?: "photo" | "video";
  framed?: boolean;
  class?: string;
  transitionName?: string;
  /** Above the fold: load eagerly with high priority. */
  priority?: boolean;
  /** Small corner tag, e.g. "Generated image · demo" for preview-only imagery. */
  tag?: string;
  sizes?: string;
}
const {
  image,
  alt = "",
  height,
  class: className,
  transitionName,
  priority = false,
  tag,
  sizes = "(min-width: 1200px) 1280px, 100vw",
  ...placeholder
} = Astro.props;
---

{image ? (
  <div
    class:list={["media", className]}
    style={height ? `height:${height}` : undefined}
    transition:name={transitionName}
  >
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1440, 2000]}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
    />
    {tag && <span class="media__tag">{tag}</span>}
  </div>
) : (
  <ImagePlaceholder
    {...placeholder}
    height={height}
    class={className}
    transitionName={transitionName}
  />
)}

<style>
  .media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bone);
  }
  .media[style] {
    aspect-ratio: auto;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media__tag {
    position: absolute;
    left: 16px;
    bottom: 14px;
    padding: 4px 8px;
    background: var(--ink);
    color: var(--white);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.4;
  }
</style>
