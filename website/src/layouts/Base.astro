---
import "@fontsource/cormorant-garamond/latin-500-italic.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  abs,
  breadcrumbList,
  faqPage,
  professionalService,
  siteEntities,
  type Crumb,
} from "../lib/seo";

interface Props {
  /** ≤ 60 characters. */
  title: string;
  /** ≤ 155 characters. */
  description: string;
  headerVariant?: "light" | "ink" | "overlay";
  /** Root-relative OG image path. */
  image?: string;
  noindex?: boolean;
  /** Breadcrumb trail after Home. */
  breadcrumbs?: Crumb[];
  faqs?: { q: string; a: string }[];
  jsonLd?: Record<string, unknown>[];
  isHome?: boolean;
}

const {
  title,
  description,
  headerVariant = "light",
  image = "/og/default.png",
  noindex = false,
  breadcrumbs = [],
  faqs,
  jsonLd = [],
  isHome = false,
} = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = abs(image, site);

const ld = [
  ...siteEntities(site),
  ...(isHome ? [professionalService(site)] : []),
  ...jsonLd,
  ...(faqs?.length ? [faqPage(faqs)] : []),
  ...(isHome ? [] : [breadcrumbList([{ name: "Home", path: "/" }, ...breadcrumbs], site)]),
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/brand/massar_mono_green.png" />
    <link
      rel="preload"
      href="/fonts/switzer-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/switzer-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#FFFFFF" />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex"
          : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      }
    />
    <meta property="og:locale" content="en_US" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <meta property="og:type" content={isHome ? "website" : "article"} />
    <meta property="og:site_name" content="Massar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {site && <link rel="sitemap" href="/sitemap-index.xml" />}
    {ld.map((obj) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <Header variant={headerVariant} />
    <main id="main">
      <slot />
    </main>
    {Astro.slots.has("footer") ? (
      <Footer>
        <slot name="footer" />
      </Footer>
    ) : (
      <Footer />
    )}
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
