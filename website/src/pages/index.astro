---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import Button from "../components/Button.astro";
import Media from "../components/Media.astro";
import StatBlock from "../components/StatBlock.astro";
import CaseCard from "../components/CaseCard.astro";
import CaseFilter from "../components/CaseFilter.astro";
import FAQ from "../components/FAQ.astro";
import HeroMonogram from "../components/HeroMonogram.astro";
import ProblemSolver from "../components/ProblemSolver.astro";
import MovingParts from "../components/MovingParts.astro";
import { getProblems, getWork } from "../lib/content";
import { homeFaqs, org, processSteps, services } from "../data/site";

const work = await getWork();
const problems = await getProblems();
const featured = work.find((w) => w.data.featured) ?? work[0];
const clients = ["[Client]", "[Client]", "[Client]", "[Client]", "[Client]"];
---

<Base
  title="Massar — Creative + business partner, Cairo"
  description="Massar finds the real business problem, sets one direction and delivers it: strategy, brand, marketing and execution under one accountable owner."
  faqs={homeFaqs}
  isHome
>
  <!-- HERO: the title owns the full width; the mark sits under it -->
  <section class="container hero" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero__title">
      <span class="line" style="--i:0">
        Too many moving parts?
      </span>
      <span class="line hero__green" style="--i:1">
        One clear direction.
      </span>
    </h1>
    <div class="hero__row">
      <div class="hero__copy">
        <p class="hero__sub">
          Massar is a creative and business partner in Cairo. We find the real business problem, set
          one direction, and deliver it: strategy, brand, marketing and execution under one
          accountable owner.
        </p>
        <div class="hero__ctas">
          <Button href="/start">Start a project</Button>
          <Button href="#problems" variant="secondary">
            Find your problem
          </Button>
        </div>
        <p class="hero__trusted">Trusted by {clients.join(", ")}.</p>
      </div>
      <div class="hero__visual">
        <HeroMonogram />
      </div>
    </div>
  </section>

  <!-- FEATURED CASE: full-bleed picture, problem → result -->
  {featured && (
    <section class="tone-ink featured" id="work" aria-labelledby="featured-title">
      <div class="container featured__head">
        <h2 id="featured-title" class="h2">
          {featured.data.client}: {featured.data.summary}
        </h2>
        <Button href={`/work/${featured.id}`} variant="link" on="dark">
          Read the case study
        </Button>
      </div>
      <a href={`/work/${featured.id}`} class="featured__media" tabindex="-1" aria-hidden="true">
        <Media
          image={featured.data.hero}
          alt={featured.data.heroAlt}
          tag={featured.data.demoImages ? "Stock photo · demo" : undefined}
          shot={featured.data.heroShot}
          tone={featured.data.heroTone}
          height="clamp(320px, 52vw, 760px)"
          sizes="100vw"
          class="scale-in"
          transitionName={`case-${featured.id}`}
        />
      </a>
      <div class="container featured__flow">
        <div class="flow__step">
          <h3 class="flow__k">The problem</h3>
          <p>{featured.data.problem}</p>
        </div>
        <div class="flow__step">
          <h3 class="flow__k">What we did</h3>
          <p>{featured.data.solution}</p>
        </div>
        {featured.data.results[0] && (
          <div class="flow__step">
            <h3 class="flow__k">The result</h3>
            <StatBlock
              value={featured.data.results[0].value}
              caption={featured.data.results[0].metric}
            />
          </div>
        )}
      </div>
    </section>
  )}

  <!-- PROBLEMS: the visitor picks theirs -->
  <Section id="problems" labelledby="problems-title">
    <SectionHead title="Start with the problem. We'll show you the case." id="problems-title">
      <p slot="aside" class="aside-text">
        Pick the one that sounds like you: what usually causes it, what we do about it, and where
        we've done it before.
      </p>
    </SectionHead>
    <ProblemSolver problems={problems} work={work} />
  </Section>

  <!-- THE LIVE THING: many parts become one path -->
  <Section tone="green" labelledby="mp-title">
    <MovingParts />
  </Section>

  <!-- PROCESS: one path, five stations -->
  <Section id="process" labelledby="process-title">
    <SectionHead title="One path. Same five stations, every project." id="process-title">
      <Button slot="aside" href="/process" variant="link">
        How each step works
      </Button>
    </SectionHead>
    <ol class="path">
      {processSteps.map((s, i) => (
        <li class:list={["path__stop", { "path__stop--end": i === processSteps.length - 1 }]}>
          <span class="path__dot" aria-hidden="true" />
          <h3 class="path__name">{s.name}</h3>
          <p class="path__line">{s.line}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- CASE STUDIES -->
  <Section tone="green" labelledby="cases-title">
    <SectionHead title="Problem. Direction. Result." id="cases-title">
      <CaseFilter slot="aside" target="home-cases" />
    </SectionHead>
    <div class="cases" id="home-cases">
      {work.map((w, i) => (
        <CaseCard
          href={`/work/${w.id}`}
          slug={w.id}
          client={w.data.client}
          summary={w.data.summary}
          tags={w.data.tags}
          sector={w.data.sector}
          result={w.data.results[0]}
          shot={w.data.heroShot}
          tone={w.data.heroTone}
          image={w.data.hero}
          alt={w.data.heroAlt}
          demo={w.data.demoImages}
          height={i === 0 ? "clamp(300px, 40vw, 580px)" : "clamp(220px, 22vw, 320px)"}
        />
      ))}
    </div>
    <Button href="/work" variant="secondary" on="dark" class="self-start">
      All case studies
    </Button>
  </Section>

  <!-- SERVICES + FAQ -->
  <Section id="faq" labelledby="do-title">
    <div class="split">
      <div class="split__a">
        <h2 id="do-title" class="h2">
          What we do
        </h2>
        <ul class="services">
          {services.map((s) => (
            <li>
              <span class="services__name">{s.name}</span>
              <span class="services__line">{s.line}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="split__b">
        <h2 class="h2">Questions</h2>
        <FAQ items={homeFaqs} />
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <section class="cta tone-green" aria-labelledby="cta-title">
    <div class="container cta__inner">
      <div class="cta__main">
        <div class="cta__rule" aria-hidden="true"></div>
        <h2 id="cta-title" class="cta__title">
          Bring us the problem.
          <br />
          We'll bring one direction.
        </h2>
        <p class="cta__tagline">{org.tagline}</p>
      </div>
      <div class="cta__pick">
        <p class="cta__ask">Which one is yours?</p>
        <ul>
          {problems.map((p) => (
            <li>
              <a href={`/start?problem=${encodeURIComponent(p.data.title)}`}>
                "{p.data.title}" <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <Button href="/start" on="dark" size="lg">
          Start a project
        </Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 80px 104px;
  }
  .hero__title {
    font-size: clamp(48px, 7.4vw, 112px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .hero__title .line {
    display: block;
  }
  .hero__green {
    color: var(--green);
  }
  .hero__row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px var(--gutter);
    align-items: end;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .hero__sub {
    max-width: 34ch;
    font-size: 22px;
    line-height: 1.55;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__trusted {
    font-size: 15px;
    color: var(--ink);
  }

  .featured {
    padding-block: min(120px, var(--section-y));
  }
  .featured__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 24px 48px;
    margin-bottom: 56px;
  }
  .featured__head .h2 {
    max-width: 16em;
  }
  .featured__media {
    display: block;
  }
  .featured__flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px var(--gutter);
    margin-top: 64px;
  }
  .flow__step {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .flow__k {
    font-size: 16px;
    font-weight: 600;
    color: var(--stone);
  }
  .flow__step p {
    font-size: 24px;
    line-height: 1.4;
  }

  .aside-text {
    max-width: 420px;
    font-size: var(--t-body);
    line-height: 1.6;
  }

  .path {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .path::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 11px;
    height: 6px;
    background: var(--green);
  }
  .path__stop {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .path__dot {
    width: 28px;
    height: 28px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: inset 0 0 0 6px var(--green);
  }
  .path__stop--end .path__dot {
    background: var(--clay);
    box-shadow: none;
  }
  .path__name {
    font-size: var(--t-h3);
    line-height: 1.2;
  }
  .path__line {
    font-size: 17px;
    line-height: 1.55;
  }

  .cases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 72px var(--gutter);
  }
  .cases > :global(:first-child) {
    grid-column: 1 / -1;
  }
  :global(.self-start) {
    align-self: flex-start;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px 96px;
  }
  .split__a,
  .split__b {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .services {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .services li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .services__name {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--green);
  }
  .services__line {
    max-width: 40ch;
    font-size: 17px;
    line-height: 1.55;
  }

  .cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: 56px;
    padding-block: var(--section-y);
  }
  .cta__main {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .cta__rule {
    width: 96px;
    height: 6px;
    background: var(--clay);
  }
  .cta__title {
    font-size: clamp(40px, 5.4vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .cta__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 34px;
    line-height: 1.2;
  }
  .cta__pick {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cta__ask {
    font-size: 18px;
    font-weight: 600;
  }
  .cta__pick ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }
  .cta__pick li a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    background: var(--white);
    color: var(--green);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
    transition: transform 200ms var(--ease-out);
  }
  .cta__pick li a:hover {
    transform: translateX(6px);
  }
  .cta__pick li a span {
    color: var(--clay);
  }
  .cta__pick :global(.btn) {
    align-self: flex-start;
  }

  @media (max-width: 1023px) {
    .hero__row,
    .split,
    .cta__inner {
      grid-template-columns: 1fr;
    }
    .featured__flow {
      grid-template-columns: 1fr;
    }
    .cases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .hero {
      padding-block: 48px 72px;
      gap: 36px;
    }
    .hero__sub {
      font-size: var(--t-body);
    }
    .flow__step p {
      font-size: 20px;
    }
    .cases {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .path {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-left: 48px;
    }
    .path::before {
      left: 11px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 6px;
      height: auto;
    }
    .path__dot {
      position: absolute;
      left: -48px;
      top: 0;
      margin: 0;
    }
  }
</style>
