---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import Button from "../components/Button.astro";
import FAQ from "../components/FAQ.astro";
import HeroParts from "../components/HeroParts.astro";
import ProblemRows from "../components/ProblemRows.astro";
import StatementReveal from "../components/StatementReveal.astro";
import CaseStack from "../components/CaseStack.astro";
import MovingParts from "../components/MovingParts.astro";
import ServiceRows from "../components/ServiceRows.astro";
import Path from "../components/Path.astro";
import CtaBand from "../components/CtaBand.astro";
import { getProblems, getWork } from "../lib/content";
import { homeFaqs, processSteps } from "../data/site";
import imgMarketing from "../assets/demo/s04-billboard-road.jpg";
import imgBizdev from "../assets/demo/s10-store-service.jpg";
import imgBrand from "../assets/demo/s01-cafe-shopfront.jpg";
import imgConsulting from "../assets/demo/s08-clinic-reception.jpg";

const work = await getWork();
const problems = await getProblems();
---

<Base
  title="Massar | Marketing & business partner in Cairo, Egypt"
  description="Marketing agency and business partner in Cairo. Massar finds the real problem behind your brand, ads or launch, sets one direction and owns the result."
  faqs={homeFaqs}
  headerVariant="overlay"
  isHome
>
  <HeroParts />

  <StatementReveal
    id="statement"
    text="Most marketing problems aren't marketing problems. They're direction problems."
  />

  <Section id="problems" labelledby="problems-title">
    <SectionHead title="Sound familiar?" id="problems-title">
      <Button slot="aside" href="/problems" variant="link">
        All problems
      </Button>
    </SectionHead>
    <ProblemRows problems={problems} work={work} />
  </Section>

  <section class="container proof-head" aria-labelledby="proof-title">
    <h2 id="proof-title" class="h2">
      Problems we've already solved.
    </h2>
    <a href="/work" class="link">
      All case studies
    </a>
  </section>
  {work.length > 0 && <CaseStack work={work} />}

  <Section labelledby="services-title">
    <SectionHead title="What we use to fix it" id="services-title">
      <Button slot="aside" href="/services" variant="link">
        All services
      </Button>
    </SectionHead>
    <ServiceRows
      images={{
        marketing: imgMarketing,
        "business-development": imgBizdev,
        brand: imgBrand,
        consulting: imgConsulting,
      }}
    />
  </Section>

  <Section tone="green" labelledby="mp-title">
    <MovingParts />
  </Section>

  <Section id="process" labelledby="process-title">
    <SectionHead title="One path. Five stations." id="process-title">
      <Button slot="aside" href="/process" variant="link">
        How each step works
      </Button>
    </SectionHead>
    <Path stops={processSteps} />
  </Section>

  <Section id="faq" labelledby="faq-title" class="faq-section">
    <div class="faq">
      <h2 id="faq-title" class="h2">
        Questions
      </h2>
      <FAQ items={homeFaqs} />
    </div>
  </Section>

  <CtaBand />
</Base>

<style>
  .proof-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px 48px;
    padding-bottom: 48px;
  }
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px 96px;
  }
  :global(.faq-section) :global(.section__inner) {
    padding-top: 0;
  }
  @media (max-width: 1023px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }
</style>
