---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import PageHero from "../components/PageHero.astro";
import hero from "../assets/demo/process-path.jpg";
import Path from "../components/Path.astro";
import FAQ from "../components/FAQ.astro";
import CtaBand from "../components/CtaBand.astro";
import { processSteps } from "../data/site";
import { howTo } from "../lib/seo";

const principles = [
  {
    title: "One owner",
    text: "One person at Massar answers for the result. You never chase five suppliers for one answer.",
  },
  {
    title: "One objective",
    text: "Agreed in numbers and in writing before we make anything. If work doesn't serve it, it waits.",
  },
  {
    title: "Plain reports",
    text: "Every number comes with its period and its source. What moved, what didn't, and why.",
  },
];
const faqs = [
  {
    q: "Do we have to go through all five stations?",
    a: "[Whether a client can join at Build or Prove, and when Diagnose is required.]",
  },
  { q: "How long does the whole path take?", a: "[Typical range in weeks, and what changes it.]" },
  { q: "What do you need from us to start?", a: "[What the client prepares for Diagnose.]" },
];
---

<Base
  title="How we work: one path, five stations | Massar"
  description="Diagnose, Direct, Build, Prove, Next step. One path with five stations on every Massar project, from the first audit to the measured result."
  breadcrumbs={[{ name: "Process", path: "/process" }]}
  faqs={faqs}
  headerVariant="overlay"
  jsonLd={[
    howTo(
      "How Massar runs a project",
      "Every Massar project follows one path with five stations: Diagnose, Direct, Build, Prove and Next step.",
      processSteps,
      Astro.site,
    ),
  ]}
>
  <PageHero
    title="One path.<br />Five stations."
    intro="Massar is Arabic for path. Every project runs the same route, in the same order, so you always know where you are and what comes next."
    image={hero}
    alt="One straight road of light trails cutting through Cairo at blue hour"
  />

  <Section labelledby="stations-title">
    <h2 id="stations-title" class="visually-hidden">
      The five stations
    </h2>
    <Path stops={processSteps} variant="detailed" />
  </Section>

  <Section tone="ink" labelledby="principles-title">
    <SectionHead title="Three rules we don't bend." id="principles-title" />
    <div class="rules">
      {principles.map((p) => (
        <div class="rule">
          <h3 class="rule__title">{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section labelledby="pfaq-title">
    <div class="faq">
      <h2 id="pfaq-title" class="h2">
        Questions about the path
      </h2>
      <FAQ items={faqs} />
    </div>
  </Section>

  <CtaBand />
</Base>

<style>
  .rules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px var(--gutter);
  }
  .rule {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .rule__title {
    font-size: var(--fs-title);
    letter-spacing: -0.015em;
    line-height: 1.05;
  }
  .rule p {
    max-width: 32ch;
    font-size: var(--fs-lead);
    line-height: 1.55;
  }
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px 96px;
  }
  @media (max-width: 1023px) {
    .rules,
    .faq {
      grid-template-columns: 1fr;
    }
  }
</style>
