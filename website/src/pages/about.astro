---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import PageHead from "../components/PageHead.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import CtaBand from "../components/CtaBand.astro";
import { org, services } from "../data/site";

const team = [1, 2, 3, 4];
const values = [1, 2, 3];
---

<Base
  title="About Massar — Creative + business partner, Cairo"
  description={org.description.slice(0, 155)}
  breadcrumbs={[{ name: "About", path: "/about" }]}
>
  <section class="container hero" aria-labelledby="about-title">
    <div class="hero__text">
      <PageHead title="Massar means path." intro={org.description} />
    </div>
    <div class="hero__mark" aria-hidden="true">
      <img src="/brand/massar_mono_green.png" width="599" height="596" alt="" />
    </div>
  </section>

  <Section tone="ink" labelledby="name-title">
    <div class="story">
      <h2 id="name-title" class="story__title">
        Four arms.
        <br />
        One centre.
      </h2>
      <div class="story__body">
        <p>
          Our mark is four arms pointing at one centre. It is the whole company in one shape:
          strategy, brand, marketing and execution, all pointing at the same objective.
        </p>
        <p>[Why Ali started Massar, in two or three sentences: the problem he kept seeing.]</p>
      </div>
    </div>
  </Section>

  <Section labelledby="do-title">
    <SectionHead title="What we do" id="do-title">
      <a slot="aside" href="/services" class="link">
        All services
      </a>
    </SectionHead>
    <ul class="services">
      {services.map((s) => (
        <li>
          <a href={`/services#${s.id}`}>
            <span class="services__name">{s.name}</span>
            <span class="services__line">{s.line}</span>
            <span class="services__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section tone="green" labelledby="team-title">
    <SectionHead title="The people you'll call." id="team-title" />
    <div class="team">
      {team.map(() => (
        <figure class="person">
          <ImagePlaceholder shot="S12" note="portrait, Ink mono" tone="ink" height="360px" />
          <figcaption>
            <span class="person__name">[Name]</span>
            <span>[Role]</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <Section labelledby="values-title">
    <SectionHead title="[Values headline]" id="values-title" />
    <div class="values">
      {values.map((n) => (
        <div class="value">
          <h3 class="h3">[Value {n}]</h3>
          <p>[What it means on a real project, in one sentence.]</p>
        </div>
      ))}
    </div>
    <p class="where">
      Based in Cairo. Working across Egypt, then the GCC. Write to{" "}
      <a class="link" href={`mailto:${org.email}`}>
        {org.email}
      </a>
      .
    </p>
  </Section>

  <CtaBand picks={false} />
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: 48px;
    padding-block: 96px 104px;
  }
  .hero__mark {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: var(--bone);
  }
  .hero__mark img {
    width: 58%;
    height: auto;
  }
  .story {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px 96px;
  }
  .story__title {
    font-size: var(--fs-title);
    letter-spacing: -0.015em;
    line-height: 1.05;
  }
  .story__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .story__body p {
    max-width: 52ch;
    font-size: var(--fs-h3);
    line-height: 1.55;
  }
  .services {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .services a {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 32px;
    align-items: baseline;
    gap: 8px 48px;
    padding: 28px 32px;
    background: var(--bone);
    transition: background-color 200ms ease;
  }
  .services a:hover {
    background: var(--green);
    color: var(--white);
  }
  .services__name {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.2;
  }
  .services__line {
    font-size: var(--fs-lead);
    line-height: 1.5;
  }
  .services__arrow {
    font-size: var(--fs-h3);
    color: var(--clay);
    transition: transform 200ms var(--ease-out);
  }
  .services a:hover .services__arrow {
    transform: translateX(4px);
    color: var(--white);
  }
  .team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 48px var(--gutter);
  }
  .person {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .person figcaption {
    display: flex;
    flex-direction: column;
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .person__name {
    font-size: var(--fs-lead);
    font-weight: 500;
  }
  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px var(--gutter);
  }
  .value {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .value p {
    font-size: var(--fs-body);
  }
  .where {
    font-size: var(--fs-lead);
  }
  .where .link {
    font-size: inherit;
  }
  @media (max-width: 1023px) {
    .hero,
    .story,
    .values {
      grid-template-columns: 1fr;
    }
    .hero__mark {
      max-width: 420px;
    }
    .services a {
      grid-template-columns: 1fr 32px;
    }
    .services__line {
      grid-column: 1;
    }
  }
  @media (max-width: 767px) {
    .hero {
      padding-block: 56px 72px;
    }
    .services a {
      padding: 22px 20px;
    }
    .story__body p {
      font-size: var(--fs-lead);
    }
  }
</style>
