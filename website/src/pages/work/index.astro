---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import SectionHead from "../../components/SectionHead.astro";
import CaseCard from "../../components/CaseCard.astro";
import CaseFilter from "../../components/CaseFilter.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getWork } from "../../lib/content";

const work = await getWork();
---

<Base
  title="Case studies — Massar"
  description="Branding, campaigns, outdoor and growth work by Massar. Each case starts with the business problem and ends with a measured result."
  breadcrumbs={[{ name: "Work", path: "/work" }]}
>
  <Section labelledby="work-title">
    <SectionHead title="Problem. Direction. Result." level={1} id="work-title">
      <CaseFilter slot="aside" target="all-cases" />
    </SectionHead>
    {work.length ? (
      <div class="cases" id="all-cases">
        {work.map((w) => (
          <CaseCard
            href={`/work/${w.id}`}
            slug={w.id}
            client={w.data.client}
            summary={w.data.summary}
            tags={w.data.tags}
            sector={w.data.sector}
            result={w.data.results[0]}
            shot={w.data.heroShot}
            tone={w.data.heroTone}
            image={w.data.hero}
            alt={w.data.heroAlt}
            demo={w.data.demoImages}
          />
        ))}
      </div>
    ) : (
      <p>Case studies are being written up. Ask us for examples in the meantime.</p>
    )}
  </Section>
  <CtaBand />
</Base>

<style>
  .cases {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr));
    gap: 72px var(--gutter);
  }
  @media (max-width: 767px) {
    .cases {
      gap: 56px;
    }
  }
</style>
