---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import SectionHead from "../../components/SectionHead.astro";
import PageHead from "../../components/PageHead.astro";
import CaseCard from "../../components/CaseCard.astro";
import CaseFilter from "../../components/CaseFilter.astro";
import CtaBand from "../../components/CtaBand.astro";
import { casesFor, getProblems, getWork } from "../../lib/content";
import { itemList } from "../../lib/seo";

const work = await getWork();
const problems = await getProblems();
---

<Base
  title="Case studies: branding, campaigns & growth | Massar"
  description="Branding, campaigns, outdoor and growth work by Massar. Each case starts with the business problem and ends with a measured result."
  breadcrumbs={[{ name: "Work", path: "/work" }]}
  jsonLd={[
    itemList(
      "Massar case studies",
      work.map((w) => ({ name: w.data.title, path: `/work/${w.id}` })),
      Astro.site,
    ),
  ]}
>
  <section class="container hero" aria-labelledby="work-title">
    <PageHead
      title="Work that solved something."
      intro="Every case here starts with a business problem and ends with a number: what it was, where it came from, and over how long."
    >
      <CaseFilter target="all-cases" />
    </PageHead>
  </section>

  <Section tone="green" labelledby="cases-title" class="cases-section">
    <h2 id="cases-title" class="visually-hidden">
      All case studies
    </h2>
    {work.length ? (
      <div class="cases" id="all-cases">
        {work.map((w, i) => (
          <CaseCard
            href={`/work/${w.id}`}
            slug={w.id}
            client={w.data.client}
            summary={w.data.summary}
            tags={w.data.tags}
            sector={w.data.sector}
            result={w.data.results[0]}
            shot={w.data.heroShot}
            tone={w.data.heroTone}
            image={w.data.hero}
            alt={w.data.heroAlt}
            demo={w.data.demoImages}
            height={i === 0 ? "clamp(300px, 40vw, 580px)" : "clamp(240px, 26vw, 380px)"}
          />
        ))}
      </div>
    ) : (
      <p class="empty">Case studies are being written up. Ask us for examples in the meantime.</p>
    )}
  </Section>

  <Section labelledby="byproblem-title">
    <SectionHead title="Or start from your problem." id="byproblem-title" />
    <ul class="byproblem">
      {problems.map((p) => {
        const n = casesFor(p.id, work).length;
        return (
          <li>
            <a href={`/problems/${p.id}`}>
              <span class="bp__q">"{p.data.title}"</span>
              <span class="bp__n">
                {n} {n === 1 ? "case" : "cases"} <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </Section>

  <CtaBand picks={false} />
</Base>

<style>
  .hero {
    padding-block: 96px 88px;
  }
  .cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px var(--gutter);
  }
  .cases > :global(:first-child) {
    grid-column: 1 / -1;
  }
  .empty {
    font-size: var(--fs-lead);
  }
  .byproblem {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .byproblem a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    height: 100%;
    padding: 28px 32px;
    background: var(--bone);
    transition: background-color 200ms ease;
  }
  .byproblem a:hover {
    background: var(--green);
    color: var(--white);
  }
  .bp__q {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.25;
  }
  .bp__n {
    flex: none;
    font-size: var(--fs-body);
    font-weight: 500;
  }
  .bp__n span {
    color: var(--clay);
  }
  .byproblem a:hover .bp__n span {
    color: var(--white);
  }
  @media (max-width: 767px) {
    .hero {
      padding-block: 56px 64px;
    }
    .cases,
    .byproblem {
      grid-template-columns: 1fr;
    }
    .cases {
      gap: 56px;
    }
    .byproblem a {
      padding: 22px 20px;
    }
  }
</style>
