---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import SectionHead from "../../components/SectionHead.astro";
import PageHero from "../../components/PageHero.astro";
import fallbackHero from "../../assets/demo/hoarding.jpg";
import Path from "../../components/Path.astro";
import CaseCard from "../../components/CaseCard.astro";
import FAQ from "../../components/FAQ.astro";
import CtaBand from "../../components/CtaBand.astro";
import { services } from "../../data/site";
import {
  casesFor,
  formatDate,
  getProblems,
  getWork,
  showDrafts,
  type Problem,
} from "../../lib/content";

export async function getStaticPaths() {
  const problems = await getProblems();
  return problems.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, others: problems.filter((p) => p.id !== entry.id) },
  }));
}

interface Props {
  entry: Problem;
  others: Problem[];
}
const { entry, others } = Astro.props;
const d = entry.data;
const cases = casesFor(entry.id, await getWork());
const stationNames = ["Diagnose", "Direct", "Build and prove"];
const q = d.title.replace(/[.!]$/, "");
const seoTitle = [`${q}? How we fix it | Massar`, `${q}? How we fix it`, q].find(
  (t) => t.length <= 60,
)!;
const faqs = [
  {
    q: `How does Massar solve "${d.title}"?`,
    a: `${d.cause} ${d.short} ${d.answer}`,
  },
  ...d.faqs,
];
const used = services.filter((s) => (s.problems as readonly string[]).includes(entry.id));
---

<Base
  title={seoTitle}
  description={d.answer.slice(0, 155)}
  noindex={d.draft && showDrafts}
  faqs={faqs}
  headerVariant="overlay"
  breadcrumbs={[
    { name: "Problems we solve", path: "/problems" },
    { name: d.title, path: `/problems/${entry.id}` },
  ]}
>
  <PageHero
    title={`"${d.title}"`}
    image={cases[0]?.data.hero ?? fallbackHero}
    alt={cases[0]?.data.heroAlt ?? "People hurrying past hoardings on a Cairo sidewalk"}
    back={{ href: "/problems", text: "All problems" }}
    compact
  />

  <section class="container hero" aria-labelledby="answer-title">
    <h2 id="answer-title" class="visually-hidden">
      The short answer
    </h2>
    <p class="answer">{d.answer}</p>
    <div class="diag">
      <div class="diag__col">
        <h2 class="diag__k">Usually behind it</h2>
        <p class="diag__big">{d.cause}</p>
      </div>
      <div class="diag__col diag__col--do">
        <h2 class="diag__k">What we do</h2>
        <p class="diag__big">{d.short}</p>
        {used.length > 0 && (
          <p class="diag__with">
            With{" "}
            {used.map((s, i) => (
              <>
                <a href={`/services#${s.id}`}>{s.name}</a>
                {i < used.length - 1 ? " and " : "."}
              </>
            ))}
          </p>
        )}
      </div>
    </div>
  </section>

  <Section tone="ink" labelledby="how-title">
    <SectionHead title="How we solve it" id="how-title" />
    <Path stops={d.steps.map((s, i) => ({ name: stationNames[i], line: s }))} class="how-path" />
  </Section>

  {cases.length > 0 && (
    <Section labelledby="related-title">
      <SectionHead title="Where we've done it" id="related-title" />
      <div class="cases">
        {cases.map((w) => (
          <CaseCard
            href={`/work/${w.id}`}
            slug={w.id}
            client={w.data.client}
            summary={w.data.summary}
            tags={w.data.tags}
            sector={w.data.sector}
            result={w.data.results[0]}
            shot={w.data.heroShot}
            tone={w.data.heroTone}
            image={w.data.hero}
            alt={w.data.heroAlt}
            demo={w.data.demoImages}
          />
        ))}
      </div>
    </Section>
  )}

  <Section tone="green" labelledby="pfaq-title">
    <div class="faq">
      <h2 id="pfaq-title" class="h2">
        Questions buyers ask
      </h2>
      <FAQ items={faqs} />
    </div>
  </Section>

  <Section labelledby="others-title">
    <SectionHead title="Not quite your problem?" id="others-title" />
    <ul class="others">
      {others.map((p) => (
        <li>
          <a href={`/problems/${p.id}`}>
            "{p.data.title}" <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="updated">
      Last updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time>
    </p>
  </Section>

  <CtaBand picks={false} />
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 96px 104px;
  }
  .answer {
    max-width: 52ch;
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.55;
  }
  .diag {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
  }
  .diag__col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 40px;
    background: var(--bone);
  }
  .diag__col--do {
    background: var(--green);
    color: var(--white);
  }
  .diag__k {
    font-size: var(--fs-body);
    font-weight: 500;
  }
  .diag__big {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.3;
  }
  .diag__with {
    margin-top: auto;
    padding-top: 12px;
    font-size: var(--fs-body);
  }
  .diag__with a {
    text-decoration: underline;
    text-decoration-color: var(--clay);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .tone-ink :global(.path__dot) {
    background: var(--ink);
    box-shadow: inset 0 0 0 6px var(--white);
  }
  .tone-ink :global(.path)::before {
    background: var(--white);
  }
  .tone-ink :global(.path) {
    --n: 3;
  }
  .tone-ink :global(.path__stop--end .path__dot) {
    background: var(--clay);
    box-shadow: none;
  }
  .cases {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(460px, 100%), 1fr));
    gap: 72px var(--gutter);
  }
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px 96px;
  }
  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .others a {
    display: inline-block;
    padding: 14px 20px;
    border-radius: 0;
    background: var(--bone);
    color: var(--green);
    font-size: var(--fs-lead);
    font-weight: 500;
    transition: background-color 200ms ease;
  }
  .others a:hover {
    background: var(--green);
    color: var(--white);
  }
  .others span {
    color: var(--clay);
  }
  .others a:hover span {
    color: inherit;
  }
  .updated {
    font-size: var(--fs-xs);
  }
  @media (max-width: 1023px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .hero {
      padding-block: 56px 72px;
    }
    .diag {
      grid-template-columns: 1fr;
    }
    .diag__col {
      padding: 28px 20px;
    }
    .answer {
      font-size: var(--fs-lead);
    }
  }
</style>
