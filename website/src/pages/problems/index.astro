---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import PageHero from "../../components/PageHero.astro";
import SplitRow from "../../components/SplitRow.astro";
import CtaBand from "../../components/CtaBand.astro";
import { casesFor, getProblems, getWork } from "../../lib/content";
import { faqPage, itemList } from "../../lib/seo";
import hero from "../../assets/demo/hoarding.jpg";
import fallback from "../../assets/demo/workshop.jpg";

const problems = await getProblems();
const work = await getWork();
---

<Base
  title="Marketing & growth problems we solve | Massar"
  description="Most businesses bring Massar one of four problems: a scattered brand, ads that don't sell, a launch with too many parts, or suppliers nobody owns."
  breadcrumbs={[{ name: "Problems we solve", path: "/problems" }]}
  headerVariant="overlay"
  jsonLd={[
    itemList(
      "Problems Massar solves",
      problems.map((p) => ({ name: p.data.title, path: `/problems/${p.id}` })),
      Astro.site,
    ),
    faqPage(
      problems.map((p) => ({
        q: `What usually causes "${p.data.title}"?`,
        a: `${p.data.cause} What Massar does: ${p.data.short}`,
      })),
    ),
  ]}
>
  <PageHero
    title="What's in the way?"
    intro="Most businesses that call us bring one of four problems. Each one usually has the same cause underneath, and a case where we've already fixed it."
    image={hero}
    alt="People hurrying past green and bone hoardings on a New Cairo sidewalk"
  />

  <Section labelledby="list-title">
    <h2 id="list-title" class="visually-hidden">
      The four problems
    </h2>
    <div class="rows">
      {problems.map((p, i) => {
        const proof = casesFor(p.id, work)[0];
        return (
          <SplitRow
            image={proof?.data.hero ?? fallback}
            alt={proof?.data.heroAlt ?? "A strategist at a wall of notes"}
            flip={i % 2 === 1}
          >
            <h2 class="row__title">
              <a href={`/problems/${p.id}`}>"{p.data.title}"</a>
            </h2>
            <dl class="row__pairs">
              <div>
                <dt>Usually behind it</dt>
                <dd>{p.data.cause}</dd>
              </div>
              <div>
                <dt>What we do</dt>
                <dd class="row__do">{p.data.short}</dd>
              </div>
            </dl>
            <div class="row__links">
              <a href={`/problems/${p.id}`} class="link">
                How we solve it
              </a>
              {proof && (
                <a href={`/work/${proof.id}`} class="row__case">
                  Solved for {proof.data.client}: {proof.data.summary}
                </a>
              )}
            </div>
          </SplitRow>
        );
      })}
    </div>
    <p class="other">
      Not on the list?{" "}
      <a href="/start" class="link">
        Tell us the problem in your own words.
      </a>
    </p>
  </Section>

  <CtaBand picks={false} />
</Base>

<style>
  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }
  .row__title {
    font-size: var(--fs-title);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }
  .row__title a:hover {
    color: var(--green);
  }
  .row__pairs {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 20px 0;
    border-block: 1px solid var(--ink);
  }
  .row__pairs dt {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--green);
  }
  .row__pairs dd {
    margin: 4px 0 0;
    font-size: var(--fs-lead);
    line-height: 1.5;
  }
  .row__do {
    font-weight: 500;
    color: var(--green);
  }
  .row__links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .row__links .link {
    align-self: flex-start;
    color: var(--green);
  }
  .row__case {
    font-size: var(--fs-xs);
  }
  .row__case:hover {
    color: var(--green);
  }
  .other {
    font-size: var(--fs-lead);
  }
</style>
