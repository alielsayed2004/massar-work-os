---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import CaseCard from "../components/CaseCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/site";
import { getProblems, getWork } from "../lib/content";

const work = await getWork();
const problems = await getProblems();
const byId = new Map(problems.map((p) => [p.id, p]));
const tones = ["ink", "white", "ink", "white"] as const;
---

<Base
  title="Services — Massar"
  description="Digital and outdoor marketing, business development, brand and consulting: four disciplines run by one team against one business objective."
  breadcrumbs={[{ name: "Services", path: "/services" }]}
>
  <section class="container hero" aria-labelledby="services-title">
    <PageHead
      title="Four disciplines.<br />One objective."
      intro="You don't buy a service from us. You bring a problem, we agree one objective, and we use only the disciplines that move it, run by one team."
    />
    <nav aria-label="Services on this page" class="jump">
      {services.map((s) => (
        <a href={`#${s.id}`}>
          {s.name} <span aria-hidden="true">↓</span>
        </a>
      ))}
    </nav>
  </section>

  {services.map((s, i) => {
    const cases = work
      .filter((w) => w.data.tags.some((t) => (s.tags as readonly string[]).includes(t)))
      .slice(0, 2);
    const solves = s.problems.map((id) => byId.get(id)).filter(Boolean);
    return (
      <section id={s.id} class:list={["svc", `tone-${tones[i]}`]} aria-labelledby={`${s.id}-title`}>
        <div class="container svc__inner">
          <div class="svc__intro">
            <h2 id={`${s.id}-title`} class="svc__name">
              {s.name}
            </h2>
            <p class="svc__line">{s.line}</p>
            {solves.length > 0 && (
              <div class="svc__solves">
                <p class="svc__k">Solves</p>
                <ul>
                  {solves.map((p) => (
                    <li>
                      <a href={`/problems/${p!.id}`}>"{p!.data.title}"</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          <div class="svc__body">
            <p class="svc__k">What's included</p>
            <ul class="svc__includes">
              {s.includes.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
            {cases.length > 0 && (
              <div class="svc__cases">
                {cases.map((w) => (
                  <CaseCard
                    href={`/work/${w.id}`}
                    slug={`${s.id}-${w.id}`}
                    client={w.data.client}
                    summary={w.data.summary}
                    tags={w.data.tags}
                    sector={w.data.sector}
                    result={w.data.results[0]}
                    shot={w.data.heroShot}
                    tone={w.data.heroTone}
                    image={w.data.hero}
                    alt={w.data.heroAlt}
                    demo={w.data.demoImages}
                    height="clamp(200px, 18vw, 260px)"
                  />
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    );
  })}

  <CtaBand />
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: 96px 104px;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .jump a {
    padding: 12px 18px;
    border-radius: 0;
    background: var(--bone);
    color: var(--green);
    font-size: var(--fs-body);
    font-weight: 500;
    transition: background-color 200ms ease;
  }
  .jump a:hover {
    background: var(--green);
    color: var(--white);
  }
  .jump span {
    color: var(--clay);
  }
  .jump a:hover span {
    color: inherit;
  }
  .svc {
    scroll-margin-top: 24px;
  }
  .svc__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px 96px;
    padding-block: min(120px, var(--section-y));
  }
  .svc__intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .svc__name {
    font-size: var(--fs-title);
    letter-spacing: -0.015em;
    line-height: 1.08;
  }
  .svc__line {
    font-size: var(--fs-lead);
    line-height: 1.5;
  }
  .svc__k {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--stone);
  }
  .tone-white .svc__k {
    color: var(--green);
  }
  .svc__solves {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
  }
  .svc__solves ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-lead);
    font-weight: 500;
  }
  .svc__solves a {
    text-decoration: underline;
    text-decoration-color: var(--clay);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .svc__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .svc__includes {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
  }
  .svc__includes li {
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.25;
  }
  .svc__cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
  }
  .svc__cases :global(.ccard__title) {
    font-size: var(--fs-lead);
  }
  @media (max-width: 1023px) {
    .svc__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .hero {
      padding-block: 56px 72px;
    }
    .svc__cases {
      grid-template-columns: 1fr;
    }
  }
</style>
