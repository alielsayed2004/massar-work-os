---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import PageHero from "../components/PageHero.astro";
import SplitRow from "../components/SplitRow.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/site";
import { getProblems, getWork } from "../lib/content";
import { serviceList } from "../lib/seo";
import hero from "../assets/demo/campaign-review.jpg";
import imgMarketing from "../assets/demo/billboard-dusk.jpg";
import imgBizdev from "../assets/demo/bizdev-table.jpg";
import imgBrand from "../assets/demo/identity-flatlay.jpg";
import imgConsulting from "../assets/demo/workshop.jpg";

const work = await getWork();
const problems = await getProblems();
const byId = new Map(problems.map((p) => [p.id, p]));
const pictures = {
  marketing: { src: imgMarketing, alt: "A lit billboard over a Cairo overpass at blue hour" },
  "business-development": {
    src: imgBizdev,
    alt: "Hands moving printed charts across a meeting table",
  },
  brand: { src: imgBrand, alt: "A brand identity flat lay in green and bone under window light" },
  consulting: { src: imgConsulting, alt: "A strategist at a wall of notes drawn into one path" },
} as const;
---

<Base
  title="Marketing, brand & business services | Massar"
  description="Digital and outdoor marketing, business development, brand and consulting: four disciplines run by one team against one business objective."
  breadcrumbs={[{ name: "Services", path: "/services" }]}
  jsonLd={[serviceList(services, Astro.site)]}
  headerVariant="overlay"
>
  <PageHero
    title="Four disciplines.<br />One objective."
    intro="You don't buy a service from us. You bring a problem, we agree one objective, and we use only the disciplines that move it, run by one team."
    image={hero}
    alt="A campaign review in a Cairo studio, posters pinned on the wall"
  >
    <nav aria-label="Services on this page" class="jump">
      {services.map((s) => (
        <a href={`#${s.id}`}>{s.name}</a>
      ))}
    </nav>
  </PageHero>

  <Section labelledby="svc-list" class="svc-section">
    <h2 id="svc-list" class="visually-hidden">
      Our services
    </h2>
    <div class="rows">
      {services.map((s, i) => {
        const pic = pictures[s.id];
        const solves = s.problems.map((id) => byId.get(id)).filter(Boolean);
        const cases = work
          .filter((w) => w.data.tags.some((t) => (s.tags as readonly string[]).includes(t)))
          .slice(0, 2);
        return (
          <SplitRow id={s.id} image={pic.src} alt={pic.alt} flip={i % 2 === 1}>
            <h2 class="svc__name">{s.name}</h2>
            <p class="svc__line">{s.line}</p>
            <ul class="svc__includes">
              {s.includes.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
            {solves.length > 0 && (
              <div class="svc__links">
                <p class="svc__k">Solves</p>
                {solves.map((p) => (
                  <a href={`/problems/${p!.id}`}>"{p!.data.title}"</a>
                ))}
              </div>
            )}
            {cases.length > 0 && (
              <div class="svc__links">
                <p class="svc__k">See it in</p>
                {cases.map((w) => (
                  <a href={`/work/${w.id}`}>
                    {w.data.client}: {w.data.summary}
                  </a>
                ))}
              </div>
            )}
          </SplitRow>
        );
      })}
    </div>
  </Section>

  <CtaBand />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .jump a {
    padding: 10px 16px;
    border: 1px solid var(--white);
    font-size: var(--fs-xs);
    font-weight: 500;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }
  .jump a:hover {
    background: var(--white);
    color: var(--ink);
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }
  .svc__name {
    font-size: var(--fs-title);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.015em;
  }
  .svc__line {
    font-size: var(--fs-lead);
    line-height: 1.55;
  }
  .svc__includes {
    display: flex;
    flex-direction: column;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .svc__includes li {
    padding: 12px 0;
    border-bottom: 1px solid var(--ink);
    font-size: var(--fs-body);
    font-weight: 500;
  }
  .svc__links {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .svc__k {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--green);
  }
  .svc__links a {
    align-self: flex-start;
    font-size: var(--fs-body);
    text-decoration: underline;
    text-decoration-color: var(--clay);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .svc__links a:hover {
    color: var(--green);
  }
</style>
